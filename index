<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Preetika Kaur - Founder, builder, and cognitive science thinker.">
    <title>Preetika Kaur</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Serif&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #1A1A2E;
            --white: #F7F7FB;
            --off-white: #EDEDF4;
            --gray: #7E7E8F;
            --lime: #6B8F7B;
            --coral: #5C6BC0;
            --lavender: #7986CB;
            --sky: #5C8A97;
            --peach: #9FA8DA;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Space Grotesk', sans-serif;
            background: var(--white);
            color: var(--black);
            overflow-x: hidden;
            cursor: default;
        }

        ::selection { background: var(--coral); color: white; }

        a { color: inherit; text-decoration: none; }

        /* ─── CUSTOM CURSOR DOT ─── */
        .cursor-dot {
            width: 10px; height: 10px;
            background: var(--coral);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            mix-blend-mode: multiply;
            transition: transform 0.15s ease;
        }

        .cursor-dot.hovering { transform: scale(4); }

        /* ─── NAV ─── */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-name {
            font-family: 'Space Mono', monospace;
            font-size: 0.82em;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .nav-right {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-right a {
            font-size: 0.8em;
            font-weight: 500;
            opacity: 0.6;
            transition: opacity 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .nav-right a:hover { opacity: 1; }

        .nav-right .resume-btn {
            opacity: 1;
            padding: 8px 18px;
            border: 1px solid rgba(28,25,23,0.15);
            border-radius: 24px;
            transition: all 0.2s;
        }

        .nav-right .resume-btn:hover {
            background: var(--black);
            color: var(--white);
            border-color: var(--black);
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--black);
            cursor: pointer;
            font-family: 'Space Mono', monospace;
            font-size: 0.8em;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ─── HERO ─── */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 40px;
            position: relative;
        }

        .hero-tag {
            font-family: 'Space Mono', monospace;
            font-size: 0.72em;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--coral);
            margin-bottom: 24px;
        }

        .hero h1 {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(3.2em, 9vw, 8em);
            font-weight: 400;
            line-height: 0.95;
            letter-spacing: -0.03em;
            margin-bottom: 32px;
        }

        .hero h1 .italic {
            font-style: italic;
            color: var(--coral);
        }

        .hero h1 .outline {
            -webkit-text-stroke: 1.5px var(--black);
            color: transparent;
        }

        .hero-bottom {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 48px;
        }

        .hero-desc {
            max-width: 380px;
            font-size: 0.92em;
            line-height: 1.6;
            color: var(--gray);
        }

        .hero-contact {
            display: flex;
            gap: 16px;
        }

        .hero-contact a {
            font-family: 'Space Mono', monospace;
            font-size: 0.72em;
            padding: 10px 20px;
            border: 1px solid rgba(28,25,23,0.1);
            border-radius: 24px;
            transition: all 0.25s;
            letter-spacing: 0.03em;
        }

        .hero-contact a:hover {
            background: var(--black);
            color: var(--white);
            border-color: var(--black);
        }

        .scroll-hint {
            position: absolute;
            bottom: 32px;
            left: 40px;
            font-family: 'Space Mono', monospace;
            font-size: 0.65em;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--gray);
            writing-mode: vertical-rl;
            animation: bob 2s ease-in-out infinite;
        }

        @keyframes bob {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(8px); }
        }

        /* ─── MARQUEE ─── */
        .marquee-wrap {
            overflow: hidden;
            border-top: 1px solid rgba(28,25,23,0.06);
            border-bottom: 1px solid rgba(28,25,23,0.06);
            padding: 18px 0;
        }

        .marquee {
            display: flex;
            gap: 48px;
            animation: scroll-left 25s linear infinite;
            width: max-content;
        }

        .marquee span {
            font-family: 'Space Mono', monospace;
            font-size: 0.75em;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            white-space: nowrap;
            color: var(--gray);
        }

        .marquee .dot {
            color: var(--coral);
        }

        @keyframes scroll-left {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* ─── SECTION STRUCTURE ─── */
        .section {
            padding: 120px 40px;
            position: relative;
        }

        .section-num {
            font-family: 'Space Mono', monospace;
            font-size: 0.65em;
            color: var(--coral);
            letter-spacing: 0.1em;
            margin-bottom: 8px;
        }

        .section-title {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(2em, 5vw, 3.5em);
            font-weight: 400;
            letter-spacing: -0.02em;
            margin-bottom: 48px;
        }

        /* ─── ABOUT ─── */
        .about-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: start;
        }

        .about-text {
            font-size: 1.05em;
            line-height: 1.8;
            color: rgba(28,25,23,0.55);
        }

        .about-text p + p { margin-top: 20px; }

        .about-right {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .edu-block {
            padding: 28px;
            border: 1px solid rgba(248,246,243,0.1);
            border-radius: 16px;
            transition: border-color 0.3s;
        }

        .edu-block:hover { border-color: var(--lavender); }

        .edu-block h3 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.2em;
            font-weight: 400;
            margin-bottom: 4px;
        }

        .edu-block .school {
            font-size: 0.82em;
            color: var(--lavender);
            font-weight: 500;
            margin-bottom: 10px;
        }

        .edu-block p {
            font-size: 0.82em;
            color: var(--gray);
            line-height: 1.6;
        }

        .skills-block h3 {
            font-family: 'Space Mono', monospace;
            font-size: 0.68em;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--gray);
            margin-bottom: 12px;
        }

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-tag {
            font-size: 0.78em;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 24px;
            border: 1px solid rgba(28,25,23,0.1);
            color: rgba(28,25,23,0.55);
            transition: all 0.2s;
        }

        .skill-tag:hover {
            border-color: var(--coral);
            color: var(--coral);
        }

        /* ─── PROJECTS ─── */
        .projects-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .project-row {
            display: grid;
            grid-template-columns: 0.4fr 1fr;
            gap: 48px;
            padding: 48px 0;
            border-bottom: 1px solid rgba(248,246,243,0.07);
            align-items: start;
            transition: background 0.3s;
        }

        .project-row:last-child { border-bottom: none; }

        .project-row:hover {
            background: rgba(28,25,23,0.03);
            margin: 0 -20px;
            padding-left: 20px;
            padding-right: 20px;
            border-radius: 12px;
        }

        .proj-meta {
            position: sticky;
            top: 100px;
        }

        .proj-meta h3 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.5em;
            font-weight: 400;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .proj-meta .type {
            font-family: 'Space Mono', monospace;
            font-size: 0.68em;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--sky);
            margin-bottom: 16px;
        }

        .proj-tech {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .proj-tech span {
            font-size: 0.7em;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 4px;
            background: rgba(28,25,23,0.06);
            color: rgba(28,25,23,0.4);
        }

        .proj-body p {
            font-size: 0.95em;
            line-height: 1.75;
            color: rgba(28,25,23,0.5);
            margin-bottom: 16px;
        }

        .proj-body ul {
            list-style: none;
            margin-bottom: 20px;
        }

        .proj-body li {
            font-size: 0.88em;
            color: rgba(28,25,23,0.4);
            padding-left: 20px;
            position: relative;
            margin-bottom: 6px;
            line-height: 1.6;
        }

        .proj-body li::before {
            content: '\2192';
            position: absolute;
            left: 0;
            color: var(--coral);
        }

        .proj-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Space Mono', monospace;
            font-size: 0.75em;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 10px 20px;
            border: 1px solid rgba(28,25,23,0.1);
            border-radius: 24px;
            transition: all 0.25s;
        }

        .proj-link:hover {
            background: var(--black);
            color: var(--white);
            border-color: var(--black);
        }

        .proj-link svg { width: 12px; height: 12px; }

        /* ─── EXPERIENCE ─── */
        .exp-list {
            display: flex;
            flex-direction: column;
        }

        .exp-row {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 48px;
            padding: 40px 0;
            border-bottom: 1px solid rgba(248,246,243,0.07);
            align-items: start;
            transition: all 0.3s;
        }

        .exp-row:last-child { border-bottom: none; }

        .exp-row:hover {
            background: rgba(28,25,23,0.03);
            margin: 0 -20px;
            padding-left: 20px;
            padding-right: 20px;
            border-radius: 12px;
        }

        .exp-row.current .exp-time::before {
            content: '';
            display: block;
            width: 8px; height: 8px;
            background: var(--coral);
            border-radius: 50%;
            margin-bottom: 8px;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.3); }
        }

        .exp-time {
            font-family: 'Space Mono', monospace;
            font-size: 0.72em;
            color: var(--gray);
            letter-spacing: 0.02em;
            line-height: 1.6;
            padding-top: 6px;
        }

        .exp-content h3 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.3em;
            font-weight: 400;
            margin-bottom: 2px;
        }

        .exp-content .org {
            font-size: 0.85em;
            font-weight: 500;
            color: var(--peach);
            margin-bottom: 12px;
        }

        .exp-content ul { list-style: none; }

        .exp-content li {
            font-size: 0.88em;
            color: rgba(28,25,23,0.45);
            padding-left: 20px;
            position: relative;
            margin-bottom: 6px;
            line-height: 1.65;
        }

        .exp-content li::before {
            content: '\2192';
            position: absolute;
            left: 0;
            color: rgba(28,25,23,0.1);
        }

        /* ─── FOOTER ─── */
        .footer {
            padding: 80px 40px;
            text-align: center;
            border-top: 1px solid rgba(28,25,23,0.06);
        }

        .footer h2 {
            font-family: 'Instrument Serif', serif;
            font-size: clamp(2em, 5vw, 3.5em);
            font-weight: 400;
            letter-spacing: -0.02em;
            margin-bottom: 16px;
        }

        .footer h2 .italic { font-style: italic; color: var(--coral); }

        .footer p {
            color: var(--gray);
            font-size: 0.92em;
            margin-bottom: 32px;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }

        .footer-links a {
            font-family: 'Space Mono', monospace;
            font-size: 0.75em;
            padding: 12px 24px;
            border: 1px solid rgba(28,25,23,0.1);
            border-radius: 24px;
            transition: all 0.25s;
            letter-spacing: 0.03em;
        }

        .footer-links a:hover {
            background: var(--black);
            color: var(--white);
            border-color: var(--black);
        }

        .footer-links a.primary {
            background: var(--coral);
            color: white;
            border-color: var(--coral);
            font-weight: 700;
        }

        .footer-links a.primary:hover {
            background: #B0714D;
        }

        .footer-copy {
            font-family: 'Space Mono', monospace;
            font-size: 0.65em;
            color: rgba(28,25,23,0.2);
            letter-spacing: 0.05em;
        }

        /* ─── REVEAL ─── */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible { opacity: 1; transform: translateY(0); }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 768px) {
            nav { padding: 16px 24px; }
            .nav-right { display: none; }
            .nav-right.open {
                display: flex;
                position: fixed;
                top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(250,250,248,0.97);
                backdrop-filter: blur(20px);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 20px;
                z-index: 99;
            }
            .nav-right.open a { font-size: 1.2em; opacity: 0.8; color: var(--black); }
            .menu-toggle { display: block; z-index: 101; }

            .hero { padding: 0 24px; }
            .hero-bottom { flex-direction: column; gap: 24px; align-items: flex-start; }
            .hero-contact { flex-wrap: wrap; }
            .scroll-hint { display: none; }

            .section { padding: 80px 24px; }

            .about-layout {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .project-row {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .proj-meta { position: static; }

            .exp-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .footer { padding: 60px 24px; }
        }

        @media (max-width: 480px) {
            .hero h1 { font-size: 2.6em; }
            .section-title { font-size: 1.8em; }
        }

        /* hide cursor dot on touch */
        @media (pointer: coarse) {
            .cursor-dot { display: none; }
        }
    </style>
</head>
